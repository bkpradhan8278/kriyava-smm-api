// Kriyava SMM — Prisma schema (Prisma 7)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  balance   Decimal  @default(0) @db.Decimal(12, 4)
  spent     Decimal  @default(0) @db.Decimal(12, 4)
  apiKey    String   @unique @default(cuid())
  role      String   @default("user")
  referralCode    String?  @unique
  referredBy      String?
  referralEarned  Decimal  @default(0) @db.Decimal(12, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  transactions Transaction[]
  tickets      Ticket[]
  favorites    Favorite[]
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  amount    Decimal  @db.Decimal(12, 4)
  method    String   @default("Razorpay")
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId   String
  serviceName String
  platform    String?
  link        String
  quantity    Int
  charge          Decimal  @db.Decimal(12, 4)
  providerCostInr Decimal  @default(0) @db.Decimal(12, 4)
  status          String   @default("Processing")
  provider    String   @default("auto")
  providerServiceId String?
  providerOrderId   String?
  providerCurrency  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Ticket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  message   String
  status    String   @default("Open")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  source    String   // "contact" | "ai_chat"
  name      String?
  email     String?
  subject   String?
  message   String
  meta      String?  // JSON: reply, surface, department, etc.
  status    String   @default("New")
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}
