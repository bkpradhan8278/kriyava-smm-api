# Kriyava API — environment

# PostgreSQL connection string (DigitalOcean managed DB gives you this)
DATABASE_URL="postgresql://user:password@host:25060/dbname?sslmode=require"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# Comma-separated allowed origins for CORS (your Vercel URL + localhost)
CORS_ORIGINS="https://web-ten-flax-20.vercel.app,http://localhost:3000,http://localhost:3001"

# Port (DO App Platform injects this automatically)
PORT=4000
